        ],
        "relativeTo": "member-heading",
        "clipToDisplay": false
      },
      "parser": "member_id"
    },
    "account-member-id": {
      "region": {
        "box": [
          140,
          140,
          228,
          158
        ],
        "relativeTo": "account-heading",
        "clipToDisplay": false
      },
      "parser": "member_id"
    },
    "member-name": {
      "region": {
        "box": [
          78,
          110,
          400,
          138
        ],
        "relativeTo": "account-heading",
        "clipToDisplay": false
      },
      "parser": "text"
    },
    "account-type": {
      "region": {
        "box": [
          974,
          225,
          1043,
          249
        ],
        "relativeTo": "account-heading",
        "clipToDisplay": false
      },
      "parser": "text"
    },
    "currency": {
      "region": {
        "box": [
          990,
          296,
          1043,
          321
        ],
        "relativeTo": "account-heading",
        "clipToDisplay": false
      },
      "parser": "text"
    },
    "balance": {
      "region": {
        "box": [
          30,
          278,
          720,
          353
        ],
        "relativeTo": "account-heading",
        "clipToDisplay": false
      },
      "parser": "usd_minor"
    },
    "missing-message": {
      "region": {
        "box": [
          -2,
          20,
          370,
          46
        ],
        "relativeTo": "not-found",
        "clipToDisplay": false
      },
      "parser": "text"
    }
  },
  "checkpoints": {
    "search-ready": {
      "targets": [
        "search-heading"
      ],
      "assertions": []
    },
    "input-entered": {
      "targets": [
        "search-heading"
      ],
      "assertions": [
        {
          "kind": "input_equals",
          "field": "entered-id",
          "input": "memberId"
        }
      ]
    },
    "member-ready": {
      "targets": [
        "member-heading"
      ],
      "assertions": [
        {
          "kind": "input_equals",
          "field": "member-id",
          "input": "memberId"
        }
      ]
    },
    "account-ready": {
      "targets": [
        "account-heading"
      ],
      "assertions": [
        {
          "kind": "input_equals",
          "field": "account-member-id",
          "input": "memberId"
        },
        {
          "kind": "text_equals",
          "field": "account-type",
          "text": "Savings"
        },
        {
          "kind": "text_equals",
          "field": "currency",
          "text": "USD"
        }
      ]
    },
    "member-not-found": {
      "targets": [
        "not-found"
      ],
      "assertions": [
        {
          "kind": "input_equals",
          "field": "missing-message",
          "input": "memberId",
          "prefix": "No member matches ID ",
          "suffix": ". Check the ID and search again."
        }
      ]
    }
  },
  "steps": [
    {
      "id": "focus-member",
      "action": "click",
      "precondition": "search-ready",
      "timeoutSeconds": 5.0,
      "target": "member-input",
      "postconditions": [
        {
          "checkpoint": "search-ready"
        }
      ]
    },
    {
      "id": "select-input",
      "action": "hotkey",
      "precondition": "search-ready",
      "timeoutSeconds": 5.0,
      "keys": [
        "ctrl",
        "a"
      ],
      "postconditions": [
        {
          "checkpoint": "search-ready"
        }
      ]
    },
    {
      "id": "enter-member",
      "action": "type",
      "precondition": "search-ready",
      "timeoutSeconds": 5.0,
      "input": "memberId",
      "postconditions": [
        {
          "checkpoint": "input-entered"
        }
      ]
    },
    {
      "id": "search-member",
      "action": "press",
      "precondition": "input-entered",
      "timeoutSeconds": 5.0,
      "key": "enter",
      "postconditions": [
        {
          "checkpoint": "member-ready"
        },
        {
          "checkpoint": "member-not-found",
          "outcome": "member_not_found"
        }
      ]
    },
    {
      "id": "open-savings",
      "action": "click",
      "precondition": "member-ready",
      "timeoutSeconds": 5.0,
      "target": "savings-button",
      "postconditions": [
        {
          "checkpoint": "account-ready"
        }
      ]
    },
    {
      "id": "read-balance",
      "action": "extract",
      "precondition": "account-ready",
      "timeoutSeconds": 5.0,
      "fields": {
        "memberId": "account-member-id",
        "memberName": "member-name",
        "accountType": "account-type",
        "currency": "currency",
        "amountMinor": "balance"
      }
    }
  ]
}
