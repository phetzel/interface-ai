{
  "schemaVersion": "1.0",
  "name": "savings-balance",
  "capabilityVersion": "0.1.0",
  "provenance": "manually-authored-poc",
  "description": "Manual PoC: search a synthetic member, verify identity, open unique Savings, and extract validated USD balance. Not discovered by a model.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "memberId": {
        "pattern": "^[0-9]{5}$",
        "title": "Memberid",
        "type": "string"
      }
    },
    "required": [
      "memberId"
    ],
    "title": "MemberInput",
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "memberId": {
        "pattern": "^[0-9]{5}$",
        "title": "Memberid",
        "type": "string"
      },
      "memberName": {
        "pattern": "^[A-Za-z][A-Za-z .'-]{1,79}$",
        "title": "Membername",
        "type": "string"
      },
      "accountType": {
        "const": "Savings",
        "title": "Accounttype",
        "type": "string"
      },
      "currency": {
        "const": "USD",
        "title": "Currency",
        "type": "string"
      },
      "amountMinor": {
        "maximum": 99999999999999,
        "minimum": 0,
        "title": "Amountminor",
        "type": "integer"
      }
    },
    "required": [
      "memberId",
      "memberName",
      "accountType",
      "currency",
      "amountMinor"
    ],
    "title": "SavingsOutput",
    "type": "object"
  },
  "environment": {
    "platform": "linux-x11",
    "width": 1280,
    "height": 800,
    "locale": "en-US",
    "scale": 1,
    "ocrModelSha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2",
    "minimumConfidence": 80.0,
    "ocrScale": 3,
    "ocrPSM": 7,
    "totalTimeoutSeconds": 45.0
  },
