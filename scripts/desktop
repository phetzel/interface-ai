#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
usage() {
  echo 'Usage: ./scripts/desktop {up|reset} [native|bank] [fixture-scenario]'
  echo '       ./scripts/desktop {build|ready|smoke|browser-smoke|vision-probe|replay|validate-capability|screenshot|stop-input|test|down|logs|operator}'
  echo '       ./scripts/desktop action --session SESSION_ID --json ACTION_JSON'
}
command_name="${1:-help}"
case "$command_name" in
  help|-h|--help) usage; exit 0 ;;
  operator)
    echo 'Operator: http://127.0.0.1:6081/'
    exit 0 ;;
  build|up|ready|smoke|browser-smoke|vision-probe|replay|review-validate|validate-capability|export-evidence|screenshot|stop-input|reset|down|logs|action|test) ;;
  *) usage >&2; exit 2 ;;
esac
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo 'Docker is unavailable. Start Docker Desktop, then retry.' >&2
  exit 1
fi
shift
case "$command_name" in
  build) docker compose build desktop ;;
  up|reset)
    # Preserve a running mode unless the operator explicitly chooses another.
    current_mode="$(docker compose exec -T desktop python -c "import os; print(os.environ.get('DESKTOP_APP','native'))" 2>/dev/null || true)"
    desktop_mode="${1:-${current_mode:-native}}"
    case "$desktop_mode" in native|bank) ;; *) echo 'Mode must be native or bank' >&2; exit 2 ;; esac
    export DESKTOP_APP="$desktop_mode"
    mkdir -p tmp/desktop-artifacts
    if ! docker image inspect interface-ai-desktop:local >/dev/null 2>&1; then docker compose build desktop; fi
    if [[ "$desktop_mode" == bank ]]; then
      ./scripts/fixture up "${2:-default}"
      # The fixture script already selected and health-checked its scenario.
      # Re-resolving dependencies here would reset its environment to defaults.
      docker compose --profile bank up --no-deps --no-build --pull never --detach --force-recreate --wait --wait-timeout 60 gateway
    fi
    if [[ "$command_name" == reset || "$desktop_mode" == bank ]]; then
      docker compose --profile bank up --remove-orphans --no-build --pull never --detach --force-recreate --wait --wait-timeout 120 desktop operator
    else
      docker compose --profile bank up --remove-orphans --no-build --pull never --detach --wait --wait-timeout 120 desktop operator
    fi
    "$0" ready
    "$0" operator
    ;;
  ready|screenshot|stop-input) docker compose exec -T desktop python /opt/desktop/control.py "$command_name" ;;
  smoke) docker compose exec -T desktop python /opt/desktop/smoke.py ;;
  browser-smoke) docker compose exec -T desktop python /opt/desktop/browser_smoke.py "$@" ;;
  vision-probe) docker compose exec -T desktop python /opt/desktop/vision_probe.py "$@" ;;
  replay|review-validate|validate-capability|export-evidence) docker compose exec -T desktop python -m interface_ai.cli "$command_name" "$@" ;;
  action) docker compose exec -T desktop python -m interface_ai.cli action "$@" ;;
  test) docker compose exec -T desktop python -m unittest discover -s /opt/engine/tests -v ;;
  down) docker compose --profile bank down --remove-orphans --timeout 10 ;;
  logs) docker compose logs --tail 100 desktop operator ;;
esac
