#!/usr/bin/env python3
"""Managed by scripts/desktop; no separate setup command needed."""

import argparse
from lib.operator_host import Server, lifecycle

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('operation', choices=['ensure', 'stop', 'serve'])
args = parser.parse_args()
if args.operation == 'serve':
    with Server() as server:
        server.serve_forever(poll_interval=0.2)
else:
    lifecycle(args.operation)
