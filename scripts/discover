#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.12"
# dependencies = ["openai==3.16.2"]
# ///
"""Explicit online goal discovery. The key and provider SDK remain on the host."""

import argparse
import logging
import os
import sys
import subprocess
from lib.acceptance import ROOT, attempt, source_hashes, write_json
from lib.builds import retain_builds, verify_running
from lib.discovery import MODEL, ProbeError, Transport, bootstrap, load_key
from lib.discovery_flow import run_discovery
from lib.discovery_request import DiscoveryRequest


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog='Examples: "Find the savings balance for member 00123"; '
        '"Read the current savings account balance for member ID 00456". '
        'Only this read-only workflow and the approved synthetic-bank target are supported.',
    )
    parser.add_argument('--member-id', help='Five-digit input binding; otherwise derived from goal')
    parser.add_argument(
        '--goal', help='Savings-balance lookup in natural language; see --help examples'
    )
    parser.add_argument(
        '--target', default='synthetic-bank', help='synthetic-bank or http://fixture:4173/'
    )
    parser.add_argument(
        '--reset', action='store_true', help='Reset the approved target before discovery'
    )
    parser.add_argument(
        '--check-request',
        action='store_true',
        help='Validate goal/target only; no key, model or desktop',
    )
    parser.add_argument('--key-file')
    args = parser.parse_args()
    try:
        request = DiscoveryRequest.parse(args.goal, args.target, args.member_id)
    except ValueError as exc:
        parser.error(str(exc))
    if args.check_request:
        print('VALID savings-balance goal for approved target synthetic-bank')
        return 0
    directory = attempt('discovery-runs')
    directory.chmod(0o700)
    report = dict(
        format='discovery-host-v1',
        provenance='real-openai-goal-discovery',
        requestedModel=MODEL,
        status='running',
        requestsAttempted=0,
        responsesCompleted=0,
        responses=[],
        usageUnknown=False,
        actionsCompleted=0,
        screenshots='memory-only',
        rawTranscript='not-retained',
        requestKind='savings-balance',
        target=request.target,
        entryPoint=request.entry_point,
    )
    transport = None

    def save():
        write_json(directory / 'report.json', report)

    try:
        key = load_key(args.key_file)
        os.environ.pop('OPENAI_LOG', None)
        for name in ('openai', 'httpx2', 'httpcore2'):
            logging.getLogger(name).disabled = True
        from openai import OpenAI
        import httpx2

        save()
        hashes = source_hashes()
        write_json(directory / 'source-manifest.json', hashes)
        retain_builds(directory)
        if args.reset:
            environment = {k: v for k, v in os.environ.items() if not k.startswith('OPENAI_')}
            subprocess.run(
                ['./scripts/desktop', 'reset', 'bank', 'default'],
                cwd=ROOT,
                env=environment,
                check=True,
                timeout=180,
            )
        verify_running(directory)
        transport = Transport(bootstrap(), prefix='discover')
        with OpenAI(
            api_key=key,
            base_url='https://api.openai.com/v1',
            max_retries=0,
            timeout=30,
            http_client=httpx2.Client(trust_env=False, timeout=30),
        ) as client:
            result = run_discovery(
                client, transport, report, save, request.member_id, request=request
            )
        write_json(directory / 'result.json', result)
        if source_hashes() != hashes:
            raise ProbeError('source_changed')
    except (Exception, KeyboardInterrupt) as exc:
        if transport is not None:
            try:
                transport.post('abort', {})
            except Exception:
                pass
        report['status'] = 'failed'
        report['code'] = exc.code if isinstance(exc, ProbeError) else 'preflight_or_storage_failed'
        try:
            save()
        except OSError:
            pass
    print(report['status'].upper() + ' ' + report.get('code', 'goal_discovery'))
    print('Evidence: ' + str(directory))
    return 0 if report['status'] == 'passed' else 1


if __name__ == '__main__':
    sys.exit(main())
